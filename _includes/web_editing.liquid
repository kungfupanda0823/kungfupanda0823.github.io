{% assign repository = site.github_repository | default: "kungfupanda0823/kungfupanda0823.github.io" %}

<script>
  window.blogEditConfig = {
    repository: "{{ repository }}",
    branch: "main",
    adminUrl: "{{ '/admin/' | relative_url }}",
    posts: {
      {% for post in site.posts %}
        "{{ post.url | relative_url }}": "{{ post.path }}"{% unless forloop.last %},{% endunless %}
      {% endfor %}
    }
  };

  document.addEventListener("DOMContentLoaded", function () {
    var config = window.blogEditConfig;
    if (!config) return;

    var path = window.location.pathname;
    var normalizedPath = path.endsWith("/") ? path : path + "/";
    var sourcePath = config.posts[path] || config.posts[normalizedPath];

    if (sourcePath) {
      var editUrl = "https://github.com/" + config.repository + "/edit/" + config.branch + "/" + sourcePath;
      var editLink = document.createElement("a");
      editLink.className = "web-edit-link";
      editLink.href = editUrl;
      editLink.target = "_blank";
      editLink.rel = "noopener";
      editLink.textContent = "Edit on GitHub";
      document.body.appendChild(editLink);
    }
  });
</script>
