{% capture footer_contents %}
  <span class="footer-motto">{{ site.footer_text | default: "Forever 37.3&#8451;" }}</span>
  <span class="footer-dot" aria-hidden="true">/</span>
  <span class="footer-views" title="Total page views of this website">
    Views <span id="busuanzi_value_site_pv">--</span>
  </span>
  <span class="footer-dot" aria-hidden="true">/</span>
  <a class="footer-write-link" href="{{ '/admin/' | relative_url }}">Write</a>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center.liquid %}
      {% else %}
        {% include newsletter.liquid %}
      {% endif %}
    {% endif %}
    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}

<link rel="stylesheet" href="{{ '/assets/css/custom.css' | relative_url }}">
{% include web_editing.liquid %}
<script async src="https://busuanzi.icodeq.com/busuanzi.pure.mini.js"></script>
